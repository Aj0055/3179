{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Queensland's libraries are",
    "subtitle": "Each dot is one branch or community library (mobile libraries and offices excluded)",
    "anchor": "start",
    "font": "Newsreader",
    "fontSize": 18,
    "subtitleFont": "IBM Plex Sans",
    "subtitleColor": "#5b6660"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -12,
      -28
    ],
    "rotate": [
      -145,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/qld_lga.topojson",
        "format": {
          "type": "topojson",
          "feature": "qld_lga"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4e7e2",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/libraries.csv"
      },
      "mark": {
        "type": "circle",
        "size": 34,
        "opacity": 0.85,
        "stroke": "#fff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Independent",
              "Rural Libraries Queensland",
              "Indigenous Knowledge Centre"
            ],
            "range": [
              "#2f5d62",
              "#c08a3e",
              "#8b4a6b"
            ]
          },
          "legend": {
            "title": "Service type",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Library"
          },
          {
            "field": "council",
            "title": "Council"
          },
          {
            "field": "wifi",
            "title": "Wi-Fi"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "IBM Plex Sans"
  }
}
